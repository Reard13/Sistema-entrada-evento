# Variables del servidor. En local: copia este archivo como .env.local y pon tus valores.
# En Render se escriben en el panel (Environment), nunca en el código.

# Clave del administrador (panel completo) y de la puerta (solo escáner).
# Admiten varias separadas por coma. Usa claves largas antes de publicar.
ADMIN_PIN="CLAVE_ADMIN"
PUERTA_PIN="CLAVE_PUERTA"

# Secreto para firmar las sesiones del panel (texto largo y aleatorio).
ADMIN_SESSION_SECRET="CAMBIA_ESTE_TEXTO_LARGO_Y_ALEATORIO"

# Carpeta de datos. En Render apunta al disco persistente (/data). En local no hace falta.
# DATA_DIR="/data"
